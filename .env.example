# ---- 上游只读仓库（不得修改）----
# 书仓库：方法论与语料来源
BOOK_HOME=/Users/Admin/Documents/ai-agent-book
# 旧 RAG 仓库：知识层实现来源（本轮不迁移、不修改）
AIDE_RAG_HOME=/Users/Admin/Documents/ChatGPT/个人网站
# 个人资料仓库：画像/项目/经历/博客
PERSONAL_HOME=/Users/Admin/Documents/ChatGPT/个人网站

# ---- 模型接入（OpenAI 兼容）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://www.heiyucode.com
OPENAI_MODEL=gpt-6.1-sol
# chat_completions | responses
OPENAI_API_MODE=chat_completions

# ---- 本地索引 ----
AIDE_INDEX_DIR=artifacts/corpus-v2
AIDE_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
AIDE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---- 成本护栏（单次运行上限，美元）----
AIDE_RUN_BUDGET_USD=0.50
